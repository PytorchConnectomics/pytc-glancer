{
  "name": "pytc-glancer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "serve": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port ${PORT:-3100} --persist-to ${STATE_DIR:-.wrangler/state} ${PYTC_GLANCER_ENV_FILE:+--env-file $PYTC_GLANCER_ENV_FILE} --show-interactive-dev-session false --live-reload false",
    "test": "node --test --import tsx tests/*.test.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@bioimagetools/capability-manifest": "0.7.1",
    "drizzle-orm": "0.45.2",
    "ome-zarr.js": "0.0.20",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zarrita": "0.7.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/jsdom": "21.1.7",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "jsdom": "26.1.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
